# ============================================================================
# Touch Grass — Environment Variables
# ============================================================================
# Copy to .env and fill in your values.
# Missing optional keys won't crash the app — features degrade gracefully.
# ============================================================================

# --- Mode Selection ---
# hosted: open-weight models via cloud endpoints, MongoDB + Tiger Data
# local: single Gemma via Ollama on localhost, SQLite
# mock: canned responses for dev/CI (no keys needed)
PROVIDER_MODE=mock

# hosted: MongoDB Atlas + Tiger Data
# mongo-only: MongoDB for everything (Tiger events stored in Mongo)
# local: SQLite on disk
# mock: in-memory (reset each run)
STORE_MODE=mock

# --- Gemma (hosted mode) ---
GEMMA_BASE_URL=
GEMMA_API_KEY=
GEMMA_VISION_MODEL=
GEMMA_TEXT_MODEL=

# --- Local Model (local mode) ---
LOCAL_BASE_URL=http://localhost:11434
LOCAL_MODEL=gemma3:4b

# --- Embeddings ---
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- Tinker Fine-Tuned Writer (hosted mode, optional) ---
USE_TUNED_WRITER=false
TINKER_API_KEY=
TINKER_BASE_MODEL=

# --- Teacher Model (dataset generation only, not runtime) ---
TEACHER_BASE_URL=
TEACHER_API_KEY=
TEACHER_MODEL=

# --- TabPFN Scoring ---
TABPFN_TOKEN=
TABPFN_SERVICE_URL=

# --- Backboard (multi-model comparison, optional) ---
BACKBOARD_API_KEY=

# --- ElevenLabs (TTS/STT, optional — falls back to browser speech) ---
ELEVENLABS_API_KEY=

# --- SerpApi (search grounding, optional — falls back to cached data) ---
SERPAPI_API_KEY=

# --- MongoDB Atlas ---
MONGODB_URI=

# --- Tiger Data / TimescaleDB (optional — falls back to MongoDB) ---
TIGER_DATABASE_URL=

# --- Sentry (observability, optional — no-op when absent) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- App ---
APP_BASE_URL=http://localhost:3000
DEFAULT_CITY=Hyderabad, India
PORT=3000

# --- Personalization ---
DIFFICULTY_TARGET_MIN=0.6
DIFFICULTY_TARGET_MAX=0.7
